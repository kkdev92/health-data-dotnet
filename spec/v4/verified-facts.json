  ],
  "guides": [
    {
      "id": "webhooks.delivery",
      "url": "https://developers.google.com/health/webhooks",
      "mustContain": [
        "stores pending notifications for up to 7 days",
        "retries can cause duplicate notifications",
        "Notifications older than 7 days are discarded"
      ],
      "note": "docs/webhooks.md states these as the delivery contract. If the wording moves, the documentation is making a promise on Google's behalf that Google no longer makes."
    },
    {
      "id": "webhooks.userAgent",
      "url": "https://developers.google.com/health/webhooks",
      "mustContain": [
        "Google-Health-API-Webhooks"
      ],
      "note": "The User-Agent the receiver documentation names."
    }
  ]
}
