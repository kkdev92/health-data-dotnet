    {
      "operation": "health.users.dataTypes.dataPoints.reconcile",
      "url": "https://developers.google.com/health/reference/rest/v4/users.dataTypes.dataPoints/reconcile",
      "scopes": [
        "https://www.googleapis.com/auth/googlehealth.activity_and_fitness.readonly",
        "https://www.googleapis.com/auth/googlehealth.health_metrics_and_measurements.readonly",
        "https://www.googleapis.com/auth/googlehealth.location.readonly",
        "https://www.googleapis.com/auth/googlehealth.nutrition.readonly",
        "https://www.googleapis.com/auth/googlehealth.sleep.readonly"
      ],
      "note": "This page lists five readonly scopes. Discovery declares twelve for the same operation, adding eight writeonly ones the page omits. The generated set is the union of both; the page shrinking further is expected, not a signal to drop scopes."
    },
    {
      "operation": "health.users.getIdentity",
      "url": "https://developers.google.com/health/reference/rest/v4/users/getIdentity",
      "scopes": [
