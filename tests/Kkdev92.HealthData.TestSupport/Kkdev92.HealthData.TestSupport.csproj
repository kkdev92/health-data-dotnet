<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Scaffolding shared by the test projects. Not a test project itself, and deliberately free of
    xUnit: the Native AOT smoke application is a consumer too, and it cannot take a test framework
    with it. That constraint is what keeps this a library of fakes rather than a place assertions
    accumulate.
  -->
  <PropertyGroup>
    <IsTestProject>false</IsTestProject>
    <RootNamespace>Kkdev92.HealthData.TestSupport</RootNamespace>
    <!-- The AOT smoke application publishes this, so a problem surfaces at build rather than there. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Kkdev92.HealthData/Kkdev92.HealthData.csproj" />
  </ItemGroup>

</Project>
