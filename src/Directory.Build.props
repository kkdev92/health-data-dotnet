<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Shipping libraries. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Reflection-based serialization is never a fallback. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>

    <!-- VerifyReferenceAotCompatibility is set per project,
         because it only makes sense where the dependency set is under our control. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Package identity:
       the NuGet version axis is independent of the Google Health API version. -->
  <PropertyGroup>
    <VersionPrefix>0.3.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">alpha</VersionSuffix>
    <Authors>kkdev92</Authors>
    <Company>kkdev92</Company>
    <Product>Kkdev92.HealthData</Product>
    <Copyright>Copyright (c) kkdev92</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!--
      Two different destinations, deliberately. nuget.org renders these as "Project website" and
      "Source repository" in the sidebar, and until there was a site to point at, both said the
      same thing: two links, one place. The site is where the project sits among the others; the
      repository is where the code, the docs and the issues are.
    -->
    <PackageProjectUrl>https://kkdev92.dev/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kkdev92/health-data-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>google-health;health;fitness;sdk;rest;aot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <!-- Deterministic build / Source Link. -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!--
    Package validation. The baseline validator compares the assemblies being packed against the
    last version actually published to nuget.org, so a binary breaking change fails the pack
    rather than waiting for a reviewer to spot it in a diff.

    It was absent for 0.2.0-alpha, and for that version only. The 0.1.0-alpha surface was reshaped
    wholesale on the feedback from the first real consumer - namespaces, enum placement, resource
    names, requests as records - and every one of those is a binary break the validator would
    refuse. Comparing against 0.1.0-alpha would have produced hundreds of CP0002s that were all
    intentional, and suppressing them teaches everyone to paste suppressions, which is worse than
    not comparing for one release.

    That was a decision about one version rather than a habit, and LastVersionWithoutBaseline is
    what stopped the next version inheriting it: bump VersionPrefix past it without setting a
    baseline and the build stops with instructions. 0.2.1-alpha is where that happened, and it was
    the right release to do it in - its public surface is identical to 0.2.0-alpha's, so the
    comparison came back clean and no suppression file was needed to get there. Turning the
    validator back on during a release that does change the surface would have meant separating
    real breaks from the noise of enabling it, at the same time.

    Point it at the last version actually on nuget.org, and move it on every release. That last
    part is not left to whoever is reading this: ReleaseVersionTests compares it against the
    release the changelog names below the one being built, so forgetting it fails the build rather
    than quietly comparing against the wrong surface. A baseline that is not published at all
    already fails the restore with NU1102; the test is for the one that is published but stale.

    This complements rather than replaces the approved public API snapshot in tests/PublicApi:
    that catches a source-level change at test time, this catches a binary-level one at pack
    time, and the two do not see the same things. A type moving between assemblies is invisible
    to one; a change of parameter name is invisible to the other.
  -->
  <PropertyGroup>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.2.3-alpha</PackageValidationBaselineVersion>
    <LastVersionWithoutBaseline>0.2.0</LastVersionWithoutBaseline>
  </PropertyGroup>

  <Target Name="RequireAPackageValidationBaseline"
          BeforeTargets="Build"
          Condition="'$(IsPackable)' == 'true'
                     AND '$(PackageValidationBaselineVersion)' == ''
                     AND $([MSBuild]::VersionGreaterThan('$(VersionPrefix)', '$(LastVersionWithoutBaseline)'))">
    <Error Text="This project is version $(VersionPrefix) and no PackageValidationBaselineVersion is set. The baseline was left out for $(LastVersionWithoutBaseline)-alpha because that release reshaped the whole surface on purpose; past it, nothing would be comparing binary compatibility at all. Set PackageValidationBaselineVersion in src/Directory.Build.props to the last version published to nuget.org - see the comment above it - or, if this release is another deliberate reshape, move LastVersionWithoutBaseline forward and say why in the same commit." />
  </Target>

  <ItemGroup>
    <!--
      A separate readme for the package, not the repository one. nuget.org resolves relative links
      against itself, so every docs/ link in the repository readme would 404 there; this copy uses
      absolute URLs and drops the contributor-facing sections.
    -->
    <None Include="$(MSBuildThisFileDirectory)../eng/PACKAGE-README.md" Pack="true" PackagePath="\README.md" Visible="false" />
    <!-- Required by CC BY 4.0: the generated doc comments reproduce Google's wording. -->
    <None Include="$(MSBuildThisFileDirectory)../NOTICE" Pack="true" PackagePath="\" Visible="false" />
    <!--
      The license text itself, not only the MIT expression in the metadata. NOTICE ends with
      "See LICENSE", and without this that reference points at nothing inside the package.
    -->
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
