<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Microsoft.Extensions.DependencyInjection and IHttpClientFactory integration for Kkdev92.HealthData.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <!--
      Used directly (IOptionsMonitor<HttpClientFactoryOptions>). Referencing it rather than
      relying on Microsoft.Extensions.Http to bring it in keeps it a top-level dependency, so an
      update to Http raises it in the same change. Left transitive, the central version holds it
      below what a newer Http requires, and restore fails with NU1109.
    -->
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Kkdev92.HealthData/Kkdev92.HealthData.csproj" />
    <ProjectReference Include="../Kkdev92.HealthData.Authentication/Kkdev92.HealthData.Authentication.csproj" />
    <!--
      For AddHealthDataWebhooks. The webhook package has no third-party dependencies of its own,
      so this adds an assembly rather than a dependency tree - but it does mean an application
      that only reads carries it. The alternative was putting the wiring in the webhook package
      and giving that one a dependency on Microsoft.Extensions, which would cost every consumer of
      it, including the ones with no container at all.
    -->
    <ProjectReference Include="../Kkdev92.HealthData.Webhooks/Kkdev92.HealthData.Webhooks.csproj" />
  </ItemGroup>

</Project>
